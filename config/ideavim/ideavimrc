let mapleader = " "

" set number relativenumber
set ignorecase
set incsearch
set smartcase
set idearefactormode=keep
set clipboard^=unnamedplus
set virtualedit=onemore

set ideajoin
set multiple-cursors
set surround
set easymotion
set commentary
set NERDTree
set highlightedyank
set VimEverywhere

nmap <leader>e <action>(RecentFiles)
nmap <leader>n <action>(GotoClass)
nmap <leader>u <action>(GotoSuperMethod)
nmap <leader>q <action>(QuickJavaDoc)
nmap <leader>/ <action>(ShowErrorDescription)
nmap <leader>r <action>(Replace)
nmap <leader>f <Plug>(easymotion-s)

nmap <C-p> <action>(ParameterInfo)
nmap <C-o> <action>(Back)
nmap <C-i> <action>(Forward)
nmap <C-s-j> <action>(MoveStatementDown)
nmap <C-s-k> <action>(MoveStatementUp)

